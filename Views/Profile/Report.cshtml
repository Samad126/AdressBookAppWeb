@{
    ViewData["Title"] = "Report Details";
}

<div class="container-fluid px-4 py-4">
    <h2 class="mb-4">Report Details</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Subject:</dt>
                <dd class="col-sm-9">Problem Logging In</dd>

                <dt class="col-sm-3">Message:</dt>
                <dd class="col-sm-9">I'm unable to access my account. Please assist as soon as possible.</dd>

                <dt class="col-sm-3">Date Submitted:</dt>
                <dd class="col-sm-9">2024-05-05</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">Pending</span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-light">
            <strong>Admin Response</strong>
        </div>
        <div class="card-body">
            <p class="mb-0 text-muted"><em>No response yet.</em></p>
            <!-- Example when response is available:
            <p>We have reset your account. Please try logging in again. Let us know if the issue continues.</p>
            -->
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <a asp-controller="Profile" asp-action="Index" class="btn btn-secondary">Back to Profile</a>
        <form method="post" asp-controller="Profile" asp-action="CancelReport" asp-route-id="5" onsubmit="return confirm('Are you sure you want to cancel this report?');">
            <button type="submit" class="btn btn-danger">Cancel Report</button>
        </form>
    </div>
</div>