@{
    ViewData["Title"] = "Birthday Notification";
}

<div class="container-fluid px-4 pb-4">
    <h2 class="mt-4 mb-4">Birthday Notification</h2>

    <div class="card shadow p-4">
        <h4>🎂 Happy Birthday, John Doe! 🎉</h4>
        <p>Today is John's special day! Don't forget to send your best wishes.</p>

        <div class="mt-3">
            <button class="btn btn-primary">Send Wishes</button>
        </div>
    </div>
</div>
