@{
    ViewData["Title"] = "Profile";
}

<div class="container-fluid px-4 my-4">
    <h2 class="mb-4">Notifications</h2>

    <!-- Notification List -->
    <div class="list-group">
        <!-- Birthday Notification -->
        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary me-2">🎂</span>
                Today is <strong>John's</strong> birthday!
            </div>
            <small class="text-muted">5 mins ago</small>
        </div>

        <!-- Contact Request Notification -->
        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-warning me-2">🔔</span>
                You have a new contact request from <strong>Alice</strong>.
            </div>
            <small class="text-muted">1 hour ago</small>
        </div>

        <!-- Shared Access Notification -->
        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success me-2">📁</span>
                <strong>Bob</strong> shared his contact list with you.
            </div>
            <small class="text-muted">Yesterday</small>
        </div>

        <!-- Random Notification -->
        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger me-2">⚠️</span>
                Reminder: Update your profile information.
            </div>
            <small class="text-muted">2 days ago</small>
        </div>
    </div>
</div>