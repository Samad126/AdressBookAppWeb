@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid px-4 pb-4">
    <h2 class="mt-4 mb-3">Notifications</h2>

    <div class="d-flex mb-3">
        <button class="btn btn-secondary" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
            <i class="fas fa-filter"></i> Filter
        </button>
    </div>

    <!-- Birthday Notifications List -->
    <div class="list-group mb-4">
        <!-- Birthday: John Doe -->
        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>🎂 <strong>John Doe</strong>'s birthday is today! 🎉</div>
            <button class="btn btn-sm btn-primary">Send Wishes</button>
        </div>

        <!-- Birthday: Jane Smith -->
        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>🎂 <strong>Jane Smith</strong>'s birthday is tomorrow! 🎈</div>
            <button class="btn btn-sm btn-primary">Send Wishes</button>
        </div>
    </div>

    <!-- Bootstrap Pagination Controls -->
    <nav aria-label="Page navigation example">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
            </li>
            <li class="page-item active">
                <a class="page-link" href="#">1</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="/Notifications/Page2">2</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="/Notifications/Page2">Next</a>
            </li>
        </ul>
    </nav>
</div>

<!-- Filter Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="filterOffcanvasLabel">Filter Notifications</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form method="get">
            <div class="mb-3">
                <label for="usernameFilter" class="form-label">Username</label>
                <input type="text" class="form-control" id="usernameFilter" name="username" placeholder="Enter name...">
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>
