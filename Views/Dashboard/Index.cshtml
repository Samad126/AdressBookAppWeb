    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Recent Contacts
        </div>
        <div class="card-body overflow-auto">
            <table style="min-width: 650px;" class="table table-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Position</th>
                        <th>Office</th>
                        <th>Age</th>
                        <th>Start Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Jane Doe</td>
                        <td>Designer</td>
                        <td>New York</td>
                        <td>29</td>
                        <td>2021/11/12</td>
                    </tr>
                    <tr>
                        <td>John Smith</td>
