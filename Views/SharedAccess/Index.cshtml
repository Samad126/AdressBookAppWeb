@{
    ViewData["Title"] = "Shared Access";
}

<div class="container-fluid px-4">
    <h2 class="mt-4">Shared Access</h2>
    <p>Check <a asp-controller="AccessRequest" asp-action="Index">Access Requests</a> page for pending requests</p>

    <!-- Bootstrap Tabs -->
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="manage-access-tab"
                    data-bs-toggle="tab" data-bs-target="#manage-access"
                    type="button" role="tab" aria-controls="manage-access"
                    aria-selected="true">
                Manage Access
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="view-shared-tab"
                    data-bs-toggle="tab" data-bs-target="#view-shared"
                    type="button" role="tab" aria-controls="view-shared"
                    aria-selected="false">
                View Shared Contacts
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content mt-3" id="myTabContent">

        <!-- Manage Access Tab -->
        <div class="tab-pane fade show active" id="manage-access" role="tabpanel"
             aria-labelledby="manage-access-tab">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <a asp-controller="Contacts" asp-action="SearchUser" class="btn btn-primary">Add User</a>
                <button class="btn btn-secondary" data-bs-toggle="offcanvas" data-bs-target="#filterManageAccess">
                    Filter Users
                </button>
            </div>

            <div class="row gy-3">
                <!-- Viewer 1 -->
                <div class="col-sm-6 col-md-4">
                    <div class="card shadow-sm d-flex flex-row align-items-center p-2"
                         style="border-radius: 8px;">
                        <img src="https://picsum.photos/id/237/80/80" class="rounded"
                             style="height: 80px; width: 80px; object-fit: cover;"
                             alt="Contact Image">
                        <div class="ms-3 w-100">
                            <div class="mb-1">
                                <h6 class="mb-0">Samad Alakbarov</h6>
                                <p class="mb-0">viewer1@example.com</p>
                            </div>
                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <button class="btn btn-sm btn-primary"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        data-bs-title="Tooltip on top"
                                        title="Send a request to access this owner's contacts">
                                    Request Access
                                </button>
                                <button class="btn btn-sm btn-outline-danger">Revoke</button>
                                <button class="btn btn-sm btn-danger">Remove User</button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Viewer 2 -->
                <div class="col-sm-6 col-md-4">
                    <div class="card shadow-sm d-flex flex-row align-items-center p-2"
                         style="border-radius: 8px;">
                        <img src="https://picsum.photos/id/238/80/80" class="rounded"
                             style="height: 80px; width: 80px; object-fit: cover;"
                             alt="Contact Image">
                        <div class="ms-3 w-100">
                            <div class="mb-1">
                                <h6 class="mb-0">Samad Alakbarov</h6>
                                <p class="mb-0">viewer2@example.com</p>
                            </div>
                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <button 
                                        class="btn btn-sm btn-primary"
                                        data-bs-toggle="tooltip" 
                                        data-bs-placement="top" 
                                        data-bs-title="Tooltip on top"
                                        title="Send a request to access this owner's contacts">
                                    Request Access
                                </button>
                                <button class="btn btn-sm btn-outline-danger">Revoke</button>
                                <button class="btn btn-sm btn-danger">Remove User</button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Viewer 3 -->
                <div class="col-sm-6 col-md-4">
                    <div class="card shadow-sm d-flex flex-row align-items-center p-2"
                         style="border-radius: 8px;">
                        <img src="https://picsum.photos/id/239/80/80" class="rounded"
                             style="height: 80px; width: 80px; object-fit: cover;"
                             alt="Contact Image">
                        <div class="ms-3 w-100">
                            <div class="mb-1">
                                <h6 class="mb-0">Samad Alakbarov</h6>
                                <p class="mb-0">viewer3@example.com</p>
                            </div>
                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <button class="btn btn-sm btn-primary"
                                        data-bs-toggle="tooltip"
                                        data-bs-placement="top"
                                        data-bs-title="Tooltip on top"
                                        title="Send a request to access this owner's contacts">
                                    Request Access
                                </button>
                                <button class="btn btn-sm btn-outline-danger">Revoke</button>
                                <button class="btn btn-sm btn-danger">Remove User</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination for Manage Access -->
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="Manage Access Pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                Previous
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <!-- View Shared Contacts Tab -->
        <div class="tab-pane fade" id="view-shared" role="tabpanel"
             aria-labelledby="view-shared-tab">
            <div class="d-flex mb-3 justify-content-between align-items-center flex-wrap">
                <a href="/Contacts/SearchUser" class="btn btn-primary">Search User</a>
                <button class="btn btn-secondary" data-bs-toggle="offcanvas" data-bs-target="#filterViewShared">
                    Filter Owners
                </button>
            </div>
            <div class="row gy-3">
                <!-- Owner 1 -->
                <div class="col-sm-6 col-md-4">
                    <div class="card shadow-sm d-flex flex-row align-items-center p-2"
                         style="border-radius: 8px;">
                        <img src="https://picsum.photos/id/240/80/80" class="rounded"
                             style="height: 80px; width: 80px; object-fit: cover;"
                             alt="Contact Image">
                        <div class="ms-3 w-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="mb-0">Alice</h6>
                            </div>
                            <p class="mb-0">test@example.com</p>
                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <a asp-controller="SharedAccess"
                                   asp-action="ContactDetails"
                                   class="btn btn-sm btn-primary">
                                    View Contacts
                                </a>
                                <button class="btn btn-sm btn-danger">Remove</button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Owner 2 -->
                <div class="col-sm-6 col-md-4">
                    <div class="card shadow-sm d-flex flex-row align-items-center p-2"
                         style="border-radius: 8px;">
                        <img src="https://picsum.photos/id/241/80/80" class="rounded"
                             style="height: 80px; width: 80px; object-fit: cover;"
                             alt="Contact Image">
                        <div class="ms-3 w-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="mb-0">Bob</h6>
                            </div>
                            <p class="mb-0">test@example.com</p>
                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <a asp-controller="SharedAccess"
                                   asp-action="ContactDetails"
                                   class="btn btn-sm btn-primary">
                                    View Contacts
                                </a>
                                <button class="btn btn-sm btn-danger">Remove</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagination for View Shared Contacts -->
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="View Shared Pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                Previous
                            </a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="filterManageAccess" aria-labelledby="filterManageAccessLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="filterManageAccessLabel">Filter Users</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">
        <form id="filterManageAccessForm">
            <div class="mb-3">
                <label for="manageAccessName" class="form-label">Name or Email</label>
                <input type="text" id="manageAccessName" class="form-control" placeholder="Enter name or email...">
            </div>

            <!-- New Access Status Filter -->
            <div class="mb-3">
                <label for="accessStatusFilter" class="form-label">Access Status</label>
                <select id="accessStatusFilter" class="form-select">
                    <option value="" selected>All</option>
                    <option value="accessed">Accessed</option>
                    <option value="revoked">Revoked</option>
                </select>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="button" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="filterViewShared" aria-labelledby="filterViewSharedLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="filterViewSharedLabel">Filter Owners</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">
        <form id="filterViewSharedForm">
            <div class="mb-3">
                <label for="viewSharedOwner" class="form-label">Owner Name or email</label>
                <input type="text" id="viewSharedOwner" class="form-control" placeholder="Enter owner name or email...">
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="button" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>