@{
    ViewData["Title"] = "Groups";
}

<div class="container-fluid px-4 mt-4">
    <!-- Groups Management Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Groups Management</h2>
        <a class="btn btn-primary" asp-controller="Groups" asp-action="AddGroup">+ Create New Group</a>
    </div>

    <!-- Groups List Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAllGroups"></th>
                        <th>Group Name</th>
                        <th>Total Contacts</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="groupsTable">
                    <!-- Example Group Rows -->
                    <tr>
                        <td><input type="checkbox" class="group-checkbox"></td>
                        <td>Family</td>
                        <td>12</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2">Edit</button>
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </td>
                    </tr>
                    <tr>
                        <td><input type="checkbox" class="group-checkbox"></td>
                        <td>Work</td>
                        <td>23</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2">Edit</button>
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Bulk Action Buttons -->
            <div class="mt-3">
                <button class="btn btn-secondary me-2" id="deleteSelected">Delete Selected</button>
                <!-- <button class="btn btn-secondary me-2" id="moveSelected">Move Selected</button> -->
                <!-- <button class="btn btn-secondary" id="tagSelected">Tag Selected</button> -->
            </div>
        </div>
    </div>
</div>