@{
    ViewData["Title"] = "Add Group";
}

<div class="container-fluid px-4 pb-4">
    <h2 class="mt-4 mb-4">Add New Group</h2>

    <form id="addGroupForm" method="post" asp-action="AddGroup" asp-controller="Groups">
        <div class="mb-3">
            <label for="groupName" class="form-label">Group Name</label>
            <input type="text" class="form-control" id="groupName" name="GroupName" placeholder="Enter group name (e.g., Family, Work)" required>
        </div>

        <div class="mb-3">
            <label for="groupDescription" class="form-label">Group Description</label>
            <textarea class="form-control" id="groupDescription" name="GroupDescription" rows="3" placeholder="Enter a short description (optional)"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Add Group</button>
    </form>
</div>