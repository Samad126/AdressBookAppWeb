@{
    ViewData["Title"] = "Edit Group";
}

<div class="container-fluid px-4">
    <h2 class="mt-4">Add New Group</h2>
    <form id="add-group-form" class="mt-4">
        <div class="mb-3">
            <label for="groupName" class="form-label">Group Name</label>
            <input type="text" class="form-control" id="groupName" placeholder="Enter group name" required>
        </div>

        <div class="mb-3">
            <label for="selectContacts" class="form-label">Select Contacts</label>
            <div id="contactList" class="form-check">
                <div>
                    <input class="form-check-input" type="checkbox" value="1" id="contact1">
                    <label class="form-check-label" for="contact1">John Doe</label>
                </div>
                <div>
                    <input class="form-check-input" type="checkbox" value="2" id="contact2">
                    <label class="form-check-label" for="contact2">Jane Smith</label>
                </div>
                <div>
                    <input class="form-check-input" type="checkbox" value="3" id="contact3">
                    <label class="form-check-label" for="contact3">Alice Johnson</label>
                </div>
                <div>
                    <input class="form-check-input" type="checkbox" value="4" id="contact4">
                    <label class="form-check-label" for="contact4">Michael Brown</label>
                </div>
                <div>
                    <input class="form-check-input" type="checkbox" value="5" id="contact5">
                    <label class="form-check-label" for="contact5">Emily Davis</label>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Add Group</button>
    </form>
</div>