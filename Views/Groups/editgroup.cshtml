@{
    ViewData["Title"] = "Edit Group";
}

<div class="container-fluid px-4 pb-4">
    <h2 class="mt-4 mb-4">Edit Group</h2>

    <form id="editGroupForm" method="post" asp-action="EditGroup" asp-controller="Groups">
        <input type="hidden" id="groupId" name="GroupId" value="1" />

        <div class="mb-3">
            <label for="groupName" class="form-label">Group Name</label>
            <input type="text" class="form-control" id="groupName" name="GroupName" value="Family" required>
        </div>

        <div class="mb-3">
            <label for="groupDescription" class="form-label">Group Description</label>
            <textarea class="form-control" id="groupDescription" name="GroupDescription" rows="3">Family members and relatives.</textarea>
        </div>

        <button type="submit" class="btn btn-success">Update Group</button>
    </form>
</div>