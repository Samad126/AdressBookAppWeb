@{
    ViewData["Title"] = "Contacts";
}

<div class="container-fluid px-4">
    <h2 class="mt-4">Contacts</h2>
    <p>Check <a asp-controller="AccessRequest" asp-action="Index">Access Requests</a> page for handling (pending, accepted, rejected) requests which you have done using user key.</p>

    <form method="post" id="bulkDeleteForm">
        <div class="row align-items-start justify-content-between mb-4">
            <div class="col-lg-6 col-md-8 col-sm-12 mb-3 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addContactModal" type="button">Add New Contact</button>
                <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#importContactsModal" type="button">Import Contacts</button>
                <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#exportContactsModal" type="button">Export Contacts</button>
                <button class="btn btn-danger" type="submit">Bulk Delete</button>
            </div>

            <div class="col-lg-3 col-md-4 col-sm-12 mb-3 text-end">
                <button class="btn btn-primary w-100" data-bs-toggle="offcanvas" data-bs-target="#searchOffcanvas" aria-controls="searchOffcanvas" type="button">
                    Search Contacts
                </button>
            </div>
        </div>

        <div class="row g-3">
            @for (int i = 1; i <= 9; i++)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card shadow-sm d-flex flex-row align-items-center p-2" style="border-radius: 8px;">
                        <input type="checkbox" class="form-check-input me-2" name="selectedContacts" value="@i" />
                        <img src="https://picsum.photos/id/230/80/80" class="rounded" style="height: 80px; width: 80px; object-fit: cover;" alt="Contact Image">
                        <div class="ms-3 w-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="mb-0">Contact @i</h6>
                                <button class="btn btn-outline-warning btn-sm">★ Star</button>
                            </div>
                            <p class="mb-0" style="font-size: 0.85rem;">Phone: 123-456-78@i</p>
                            <p class="mb-1" style="font-size: 0.85rem;">Email: contact@demo.com</p>

                            <div class="d-flex gap-1 mt-2 flex-wrap">
                                <a asp-controller="Contacts" asp-action="ContactDetail" class="btn btn-info btn-sm">View</a>
                                <a asp-controller="Contacts" asp-action="EditContact" class="btn btn-warning btn-sm">Update</a>
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </form>
</div>

<div class="d-flex justify-content-center mt-4">
    <nav aria-label="Contacts Pagination">
        <ul class="pagination">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
            </li>
            <li class="page-item active" aria-current="page">
                <a class="page-link" href="#">1</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">2</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">3</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">Next</a>
            </li>
        </ul>
    </nav>
</div>

<div class="modal fade" id="addContactModal" tabindex="-1" aria-labelledby="addContactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addContactModalLabel">Add New Contact</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>Select how you want to add a new contact (if user has registered on website you can add using user key):</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-primary" asp-controller="Contacts" asp-action="AddContact">Add Manually</a>
                    <a class="btn btn-secondary" asp-controller="Contacts" asp-action="SearchUser">Add Using User Key</a>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="importContactsModal" tabindex="-1" aria-labelledby="importContactsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="importContactsModalLabel">Import Contacts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>Select source to import contacts:</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-primary" asp-controller="Contacts" asp-action="ImportFromExcel">Import from Excel (.xlsx)</a>
                    <a class="btn btn-primary" asp-controller="Contacts" asp-action="ImportFromCsv">Import from CSV (.csv)</a>
                    <a class="btn btn-success" asp-controller="Contacts" asp-action="ImportFromGoogle">Import from Google Contacts</a>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="exportContactsModal" tabindex="-1" aria-labelledby="exportContactsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exportContactsModalLabel">Export Contacts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>Select format to export contacts:</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-primary" asp-controller="Contacts" asp-action="ExportToExcel">Export to Excel (.xlsx)</a>
                    <a class="btn btn-primary" asp-controller="Contacts" asp-action="ExportToCsv">Export to CSV (.csv)</a>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="searchOffcanvas" aria-labelledby="searchOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="searchOffcanvasLabel">Search & Filter Contacts</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="searchForm" method="post">
            <div class="mb-3">
                <label for="fullnameQuery" class="form-label">Fullname</label>
                <input type="text" class="form-control mb-2" id="fullnameQuery" name="fullnameQuery" placeholder="Enter fullname...">
            </div>

            <div class="mb-3">
                <label for="emailQuery" class="form-label">Email</label>
                <input type="email" class="form-control mb-2" id="emailQuery" name="emailQuery" placeholder="Enter email...">
            </div>

            <div class="mb-3">
                <label for="phoneQuery" class="form-label">Phone Number</label>
                <input type="tel" class="form-control mb-2" id="phoneQuery" name="phoneQuery" placeholder="Enter phone number...">
            </div>

            <div class="mb-3">
                <label for="groupFilter" class="form-label">Group</label>
                <select class="form-select" id="groupFilter" name="group">
                    <option value="">All Groups</option>
                    <option value="Family">Family</option>
                    <option value="Work">Work</option>
                    <option value="Friends">Friends</option>
                    <option value="Clients">Clients</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Birthday Range</label>
                <div class="d-flex gap-2">
                    <input type="date" class="form-control" id="birthdayFrom" name="birthdayFrom" placeholder="From">
                    <input type="date" class="form-control" id="birthdayTo" name="birthdayTo" placeholder="To">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Additional Filters</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="true" id="starredFilter" name="starred">
                    <label class="form-check-label" for="starredFilter">
                        Starred Contacts
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="true" id="recentlyAddedFilter" name="recentlyAdded">
                    <label class="form-check-label" for="recentlyAddedFilter">
                        Recently Added
                    </label>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>