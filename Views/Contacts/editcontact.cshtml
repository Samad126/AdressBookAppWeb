@{
    ViewData["Title"] = "Edit Contact";
}

<div class="container-fluid px-4 pb-4">
    <form id="editContactForm" enctype="multipart/form-data" class="mt-4">
        <h2>Edit Contact</h2>

        <div class="mb-3">
            <label for="editContactImage" class="form-label">Change Contact Image</label>
            <input type="file" class="form-control" id="editContactImage" accept="image/*" onchange="previewImage(event)">
        </div>

        <div class="mb-3">
            <img id="imagePreview" src="path_to_existing_image.jpg" alt="Image Preview" class="img-thumbnail"
                 style="max-width: 200px; margin-top: 10px;">
        </div>

        <div class="mb-3">
            <label for="editContactName" class="form-label">Name</label>
            <input type="text" class="form-control" id="editContactName" value="John Doe" required>
        </div>

        <div class="mb-3">
            <label for="editContactPosition" class="form-label">Position</label>
            <input type="text" class="form-control" id="editContactPosition" value="Software Engineer">
        </div>

        <div class="mb-3">
            <label for="editContactEmail" class="form-label">Email</label>
            <input type="email" class="form-control" id="editContactEmail" value="johndoe@example.com" required>
        </div>

        <div class="mb-3">
            <label for="editContactPhone" class="form-label">Phone</label>
            <input type="tel" class="form-control" id="editContactPhone" value="+1 234 567 890" required>
        </div>

        <div class="mb-3">
            <label for="editContactAddress" class="form-label">Address</label>
            <textarea class="form-control" id="editContactAddress" rows="3">123 Main Street, Cityville, Country</textarea>
        </div>

        <div class="mb-3">
            <label for="editContactCompany" class="form-label">Company</label>
            <input type="text" class="form-control" id="editContactCompany" value="Example Corp">
        </div>

        <div class="mb-3">
            <label for="editContactGroup" class="form-label">Group</label>
            <select class="form-control" id="editContactGroup">
                <option value="Friends" selected>Friends</option>
                <option value="Family">Family</option>
                <option value="Work">Work</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="editContactTags" class="form-label">Tags</label>
            <input type="text" class="form-control" id="editContactTags" value="Work, School, Personal">
        </div>

        <button type="submit" class="btn btn-success">Update Contact</button>
    </form>
</div>
