@{
    ViewData["Title"] = "Search User";
}

<div class="container-fluid px-4">
    <!-- Page Title -->
    <div class="d-flex justify-content-between align-items-center my-4">
        <h1 class="h3">Add Contact</h1>
    </div>

    <!-- Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="searchUserForm" method="post">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="userKey" name="userKey" placeholder="Enter User's User Key" required>
                    <button class="btn btn-primary" type="submit" id="searchButton">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Search Results -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Search Results</h5>
            <div id="searchResults" class="mt-3">
                <!-- This will be dynamically populated -->
                <!-- Example User Card -->
                <div class="card mb-3">
                    <div class="card-body d-flex  justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">John Doe</h5>
                        </div>
                        <button class="btn btn-success add-user-button" data-user-id="12345" data-user-name="John Doe" data-bs-toggle="modal" data-bs-target="#addUserModal">Add Contact</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">Add Contact to Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Adding <strong id="selectedUserName"></strong> to a group.</p>
                <form id="addUserForm" method="post" >
                    <input type="hidden" name="userId" id="userId">
                    <div class="mb-3">
                        <label for="groupSelect" class="form-label">Select Group:</label>
                        <select class="form-select" name="groupId" id="groupSelect" required>
                            <option value="">Select Group</option>
                            <option value="0">No Group</option>
                            <option value="1">Friends</option>
                            <option value="2">Family</option>
                            <option value="3">Colleagues</option>
                            <option value="4">School</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
