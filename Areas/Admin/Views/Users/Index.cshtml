@{
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Users</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Users</li>
    </ol>

    <!-- Buttons -->
    <div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Add" class="btn btn-success">
                <i class="fas fa-user-plus"></i> Add User
            </a>
        </div>
        <div>
            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas">
                <i class="fas fa-filter"></i> Filter Users
            </button>
        </div>
    </div>

    <!-- Filter Offcanvas (same as before) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 id="filterOffcanvasLabel">Filter Users</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get">
                <div class="mb-3">
                    <label for="fullNameFilter" class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="fullNameFilter" name="fullName" placeholder="Enter full name">
                </div>
                <div class="mb-3">
                    <label for="emailFilter" class="form-label">Email</label>
                    <input type="email" class="form-control" id="emailFilter" name="email" placeholder="Enter email">
                </div>
                <div class="mb-3">
                    <label for="roleFilter" class="form-label">Role</label>
                    <select class="form-select" id="roleFilter" name="role">
                        <option value="">All Roles</option>
                        <option value="Admin">Admin</option>
                        <option value="User">User</option>
                    </select>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Apply Filters</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-users me-1"></i>
            Users List
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Profile</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example static users -->
                    <tr>
                        <td>1</td>
                        <td>
                            <img src="https://via.placeholder.com/50" class="rounded-circle" alt="Profile Image" width="50" height="50">
                        </td>
                        <td>John Doe</td>
                        <td>john@example.com</td>
                        <td>Admin</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-area="Admin" asp-controller="Users" asp-action="Details" class="btn btn-sm btn-info">View</a>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Edit" class="btn btn-sm btn-warning">Edit</a>
                                <a href="#" class="btn btn-sm btn-danger">Delete</a>
                                <button class="btn btn-sm btn-secondary">Reset Password</button>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>2</td>
                        <td>
                            <img src="https://via.placeholder.com/50" class="rounded-circle" alt="Profile Image" width="50" height="50">
                        </td>
                        <td>Jane Smith</td>
                        <td>jane@example.com</td>
                        <td>User</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-area="Admin" asp-controller="Users" asp-action="Details" class="btn btn-sm btn-info">View</a>
                                <a asp-area="Admin" asp-controller="Users" asp-action="Edit" class="btn btn-sm btn-warning">Edit</a>
                                <a href="#" class="btn btn-sm btn-danger">Delete</a>
                                <button class="btn btn-sm btn-secondary">Reset Password</button>
                            </div>
                        </td>
                    </tr>
                    <!-- Repeat dynamically later -->
                </tbody>
            </table>
        </div>
    </div>
</div>