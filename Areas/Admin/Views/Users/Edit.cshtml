@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit User</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <!-- IMPORTANT: enctype for file upload -->
            <form method="post" asp-action="Edit" enctype="multipart/form-data">
                @* (Backend binding will be done later) *@

                <!-- Full Name -->
                <div class="mb-3">
                    <label for="fullName" class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="fullName" name="FullName" value="John Doe" required>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" name="Email" value="john.doe@example.com" required>
                </div>

                <!-- Phone -->
                <div class="mb-3">
                    <label for="phone" class="form-label">Phone</label>
                    <input type="tel" class="form-control" id="phone" name="Phone" value="+1 234 567 8901">
                </div>

                <!-- Role -->
                <div class="mb-3">
                    <label for="role" class="form-label">Role</label>
                    <select class="form-select" id="role" name="Role">
                        <option selected>Admin</option>
                        <option>User</option>
                    </select>
                </div>

                <!-- Current Profile Image (Optional) -->
                <div class="mb-3">
                    <label class="form-label">Current Profile Image:</label><br />
                    <img src="https://via.placeholder.com/100" class="rounded-circle mb-2" width="100" height="100" alt="Current Profile Image">
                </div>

                <!-- Upload New Profile Image -->
                <div class="mb-3">
                    <label for="profileImage" class="form-label">Change Profile Image</label>
                    <input class="form-control" type="file" id="profileImage" name="ProfileImage" accept="image/*">
                </div>

                <!-- Save / Cancel Buttons -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Save Changes</button>
                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>