@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">User Details</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a></li>
        <li class="breadcrumb-item active">Details</li>
    </ol>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <!-- User Details -->
            <div class="mb-3">
                <label class="form-label fw-bold">Full Name:</label>
                <div>John Doe</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email:</label>
                <div>john.doe@example.com</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Phone:</label>
                <div>+1 234 567 8901</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Role:</label>
                <div>Admin</div>
            </div>

            @* <div class="mb-3">
                <label class="form-label fw-bold">Status:</label>
                <div><span class="badge bg-success">Active</span></div>
            </div> *@

            <div class="mb-3">
                <label class="form-label fw-bold">Registration Date:</label>
                <div>2024-05-01</div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-secondary">Back to Users</a>

                <!-- Optional future admin actions -->
                <a asp-area="Admin" asp-controller="Users" asp-action="Edit" class="btn btn-warning">Edit User</a>
                @* <a href="#" class="btn btn-danger">Deactivate User</a> *@
                <a href="#" class="btn btn-danger">Delete User</a>
            </div>
        </div>
    </div>
</div>