@{
    ViewData["Title"] = "User Activity Logs";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">User Activity Logs</h2>
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas">
                Filters
            </button>
        </div>

        <div class="card-body">
            <table class="table table-striped table-hover mt-4">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Timestamp</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Action Message</th>
                        <th>Username</th>
                    </tr>
                </thead>
                <tbody id="activityTable">
                    <tr>
                        <th>1</th>
                        <td>2025-05-06 09:15:43</td>
                        <td>System</td>
                        <td>Logged In</td>
                        <td>User <strong>JohnDoe123</strong> logged in</td>
                        <td>JohnDoe123</td>
                    </tr>
                    <tr>
                        <th>2</th>
                        <td>2025-05-06 09:20:15</td>
                        <td>Contacts</td>
                        <td>Add</td>
                        <td>User <strong>JohnDoe123</strong> added a new contact</td>
                        <td>JohnDoe123</td>
                    </tr>
                    <tr>
                        <th>3</th>
                        <td>2025-05-06 10:05:02</td>
                        <td>Profile</td>
                        <td>Edit</td>
                        <td>User <strong>JaneSmith</strong> updated profile details</td>
                        <td>JaneSmith</td>
                    </tr>
                </tbody>
            </table>


            <!-- Static Pagination -->
            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Offcanvas Filter Panel -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="filterOffcanvasLabel">Filter Logs</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="filterForm">
            <div class="mb-3">
                <label for="moduleFilter" class="form-label">Module</label>
                <select class="form-select" id="moduleFilter">
                    <option selected value="">All Modules</option>
                    <option value="Contacts">Contacts</option>
                    <option value="Groups">Groups</option>
                    <option value="Calendar">Calendar</option>
                    <option value="Shared Access">Shared Access</option>
                    <option value="Profile">Profile</option>
                    <option value="Contact Us">Contact Us</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="actionTypeFilter" class="form-label">Action Type</label>
                <select class="form-select" id="actionTypeFilter">
                    <option selected value="">All Actions</option>
                    <option value="Add">Add</option>
                    <option value="Edit">Edit</option>
                    <option value="Delete">Delete</option>
                    <option value="Give Access">Give Access</option>>
                    <option value="Revoke Access">Revoke Access</option>>
                    <option value="Logged In">Logged In</option>
                    <option value="Logged Out">Logged Out</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Date Range</label>
                <div class="d-flex gap-2">
                    <input type="date" class="form-control" id="dateFrom" placeholder="From">
                    <input type="date" class="form-control" id="dateTo" placeholder="To">
                </div>
            </div>

            <div class="mb-3">
                <label for="usernameFilter" class="form-label">Username</label>
                <input type="text" class="form-control" id="usernameFilter" placeholder="Enter username">
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="button" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>