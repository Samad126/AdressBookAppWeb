@{
    ViewData["Title"] = "Contact Reports";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Contact Reports</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Contact Reports</li>
    </ol>

    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas" aria-controls="filterOffcanvas">
            <i class="fas fa-filter"></i> Filter Reports
        </button>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 id="filterOffcanvasLabel">Filter Contact Reports</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get">
                <div class="mb-3">
                    <label for="senderFilter" class="form-label">Sender Name</label>
                    <input type="text" class="form-control" id="senderFilter" name="sender" placeholder="Enter sender name">
                </div>
                <div class="mb-3">
                    <label for="emailFilter" class="form-label">Email</label>
                    <input type="email" class="form-control" id="emailFilter" name="email" placeholder="Enter email">
                </div>
                <div class="mb-3">
                    <label for="subjectFilter" class="form-label">Subject</label>
                    <input type="text" class="form-control" id="subjectFilter" name="subject" placeholder="Enter subject">
                </div>
                <div class="mb-3">
                    <label for="statusFilter" class="form-label">Status</label>
                    <select class="form-select" id="statusFilter" name="status">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Reviewed">Reviewed</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="dateFilter" class="form-label">Date</label>
                    <input type="date" class="form-control" id="dateFilter" name="date">
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <button type="button" class="btn btn-secondary">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-envelope me-1"></i>
            Incoming Contact Us Messages
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Sender Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Michael Brown</td>
                        <td>michael@example.com</td>
                        <td>Problem Logging In</td>
                        <td>I'm unable to access my account. Please assist.</td>
                        <td><span class="badge bg-warning text-dark">Pending</span></td>
                        <td>2024-05-05</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-area="Admin" asp-controller="ContactReports" asp-action="Detail" class="btn btn-sm btn-info">View or Reply</a>
                                <a href="#" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Sarah Wilson</td>
                        <td>sarah@example.com</td>
                        <td>Suggestion for Feature</td>
                        <td>It would be great to have a dark mode!</td>
                        <td><span class="badge bg-success">Reviewed</span></td>
                        <td>2024-05-04</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-area="Admin" asp-controller="ContactReports" asp-action="Detail" class="btn btn-sm btn-info">View or Reply</a>
                                <a href="#" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-center mt-3">
        <nav aria-label="Users pagination">
            <ul class="pagination">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                </li>
            </ul>
        </nav>
    </div>
    </div>
</div>